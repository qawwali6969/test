# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============ AI ПРОВАЙДЕР ============
# Выберите один из вариантов:

# ВАРИАНТ 1: OpenAI (по умолчанию)
USE_OPENROUTER=false
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_TEMPERATURE=0.8
# OPENAI_MAX_TOKENS=2000

# ВАРИАНТ 2: OpenRouter (разкомментируйте строки ниже)
# USE_OPENROUTER=true
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-3.5-turbo
# # Другие популярные модели:
# # OPENROUTER_MODEL=anthropic/claude-3-haiku
# # OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct
# # OPENROUTER_MODEL=google/gemini-pro
# # Полный список: https://openrouter.ai/models
#
# # Опционально для OpenRouter:
# OPENROUTER_APP_NAME=AI Content Generator
# OPENROUTER_SITE_URL=
